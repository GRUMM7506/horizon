<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Horizon" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#3A7D44</item>
        <item name="colorAccent">#4CAF50</item>
    </style>

    <style name="Theme.Horizon.Game" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Section" parent="TextAppearance.AppCompat.Title">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
</resources>
