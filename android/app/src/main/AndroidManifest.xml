<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Multiplayer, and online-mode session checks. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The renderer is Vulkan first; the launcher explains when 1.1 is missing. -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application
        android:allowBackup="false"
        android:appCategory="game"
        android:hasFragileUserData="true"
        android:icon="@drawable/ic_launcher"
        android:isGame="true"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@style/Theme.Horizon">

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The game, in a process of its own that ends with it (docs/android-port.md). Nothing
             recreates it: it follows rotation and keyboards itself. -->
        <activity
            android:name=".HorizonActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|touchscreen|locale|layoutDirection"
            android:exported="false"
            android:process=":game"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Horizon.Game">
            <meta-data android:name="android.app.lib_name" android:value="horizon_android" />
        </activity>
    </application>
</manifest>
